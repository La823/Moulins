{
  "title": "Moulins — Overview",
  "uid": "moulins-overview",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Request rate (req/s)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        { "expr": "sum(rate(http_requests_total[1m])) by (method)", "legendFormat": "{{method}}" }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Error rate — 5xx (req/s)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        { "expr": "sum(rate(http_requests_total{status=~\"5..\"}[1m]))", "legendFormat": "5xx" },
        { "expr": "sum(rate(http_requests_total{status=~\"4..\"}[1m]))", "legendFormat": "4xx" }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Request latency (p50 / p95 / p99)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p95" },
        { "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p99" }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "In-flight requests",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        { "expr": "http_requests_in_flight", "legendFormat": "in-flight" }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Slowest routes (p95, top 8)",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "targets": [
        { "expr": "topk(8, histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le, route)))", "legendFormat": "{{route}}" }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "DB pool connections",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "targets": [
        { "expr": "db_pool_acquired_conns", "legendFormat": "acquired" },
        { "expr": "db_pool_idle_conns", "legendFormat": "idle" },
        { "expr": "db_pool_total_conns", "legendFormat": "total" },
        { "expr": "db_pool_max_conns", "legendFormat": "max" }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "DB pool wait time (rate)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "targets": [
        { "expr": "rate(db_pool_wait_duration_seconds_total[5m])", "legendFormat": "wait time/s" },
        { "expr": "rate(db_pool_wait_count_total[5m])", "legendFormat": "waits/s" }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Go goroutines / heap",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 },
      "targets": [
        { "expr": "go_goroutines{job=\"backend\"}", "legendFormat": "goroutines" },
        { "expr": "go_memstats_heap_inuse_bytes{job=\"backend\"}", "legendFormat": "heap in-use bytes" }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Host CPU usage %",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 32 },
      "targets": [
        { "expr": "100 - (avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[1m])) * 100)", "legendFormat": "CPU %" }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Host load average",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 40 },
      "targets": [
        { "expr": "node_load1", "legendFormat": "1m" },
        { "expr": "node_load5", "legendFormat": "5m" },
        { "expr": "node_load15", "legendFormat": "15m" }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Host memory usage %",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 40 },
      "targets": [
        { "expr": "100 * (1 - ((node_memory_MemAvailable_bytes) / node_memory_MemTotal_bytes))", "legendFormat": "mem %" }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Host disk usage % (root)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 48 },
      "targets": [
        { "expr": "100 * (1 - (node_filesystem_avail_bytes{mountpoint=\"/\"} / node_filesystem_size_bytes{mountpoint=\"/\"}))", "legendFormat": "disk %" }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Container CPU usage (per container)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 48 },
      "targets": [
        { "expr": "sum(rate(container_cpu_usage_seconds_total{name!=\"\"}[1m])) by (name)", "legendFormat": "{{name}}" }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Container memory usage (per container)",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 56 },
      "targets": [
        { "expr": "sum(container_memory_working_set_bytes{name!=\"\"}) by (name)", "legendFormat": "{{name}}" }
      ]
    }
  ]
}
